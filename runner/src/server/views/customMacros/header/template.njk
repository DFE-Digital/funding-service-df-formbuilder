<header class="govuk-header {{ params.classes if params.classes }}" role="banner" data-module="govuk-header"
        {%- for attribute, value in params.attributes %} {{attribute}}="{{value}}"{% endfor %}>
  <div class="govuk-header__container {{ params.containerClasses | default('govuk-width-container') }}">
    <div class="govuk-header__logo">
       <svg width="277" height="31" viewBox="0 0 277 31" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
              <rect width="275" height="31" fill="url(#pattern0_339_1724)"/>
              <defs>
              <pattern id="pattern0_339_1724" patternContentUnits="objectBoundingBox" width="1" height="1">
              <use xlink:href="#image0_339_1724" transform="scale(0.000244141 0.00224719)"/>
              </pattern>
              <image id="image0_339_1724" width="4096" height="445" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
              </defs>
            </svg>
            <!-- <img src="{{ assetPath }}/images/department-for-education_white.png" alt="Department for Education" class="govuk-header__logotype"> -->
    </div> 
  </div>
</header>
<div class="service-navigation-bar">
      <div class="service-navigation-component govuk-body govuk-width-container">
          <span class="service-navigation-component__title govuk-!-font-weight-bold">
        {{params.serviceName }}
          </span>
    {% if params.signOutHref %}
          <span id="dfe-designer-signout" class="service-navigation-component__sign-out govuk-link">
            {% if language == 'cy' %}Allgofnodi{% else %}Sign out{% endif %}
          </span>
    {% endif %}
        </div>    
</div>